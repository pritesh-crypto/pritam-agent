# ─── WhatsApp (Meta Cloud API) ───────────────────────────────────────────────
# Get these from https://developers.facebook.com → your WhatsApp Business App
WHATSAPP_TOKEN=your_permanent_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_id_here
WEBHOOK_VERIFY_TOKEN=pick_any_random_secret_string_here

# ─── Anthropic (Claude) ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ─── Owner Config ────────────────────────────────────────────────────────────
# Pritesh's WhatsApp number (with country code, no + or spaces)
OWNER_PHONE=919XXXXXXXXX

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3000
# Your public URL (use ngrok for local dev: ngrok http 3000)
WEBHOOK_URL=https://your-domain.com/webhook

# ─── Agent Config ────────────────────────────────────────────────────────────
AGENT_NAME=Pritam
DAILY_LEAD_TARGET=10
LEAD_OUTREACH_HOUR=10
# Time zone
TZ=Asia/Kolkata
